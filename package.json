{
  "name": "viell-effect-schema-http",
  "version": "0.1.0-alpha.2",
  "keywords": [],
  "author": "viell",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./Body": {
      "types": "./dist/http/Body.d.ts",
      "default": "./dist/http/Body.js"
    },
    "./Request": {
      "types": "./dist/http/Request.d.ts",
      "default": "./dist/http/Request.js"
    },
    "./Response": {
      "types": "./dist/http/Response.d.ts",
      "default": "./dist/http/Response.js"
    },
    "./Operation": {
      "types": "./dist/http/Operation.d.ts",
      "default": "./dist/http/Operation.js"
    },
    "./Policy": {
      "types": "./dist/http/Policy.d.ts",
      "default": "./dist/http/Policy.js"
    },
    "./Url": {
      "types": "./dist/http/Url.d.ts",
      "default": "./dist/http/Url.js"
    },
    "./Interaction": {
      "types": "./dist/concurrency/Interaction.d.ts",
      "default": "./dist/concurrency/Interaction.js"
    },
    "./package.json": "./package.json",
    "./Transport": {
      "types": "./dist/http/Transport.d.ts",
      "default": "./dist/http/Transport.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "docs",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "test:unit": "vitest run --exclude src/http/Network.test.ts",
    "test:integration": "vitest run src/http/Network.test.ts",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.82.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "@effect/platform": "^0.97.2",
    "effect": "^3.22.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "private": true,
  "description": "Consumer-owned HTTP contracts composed with Effect",
  "sideEffects": false,
  "peerDependencies": {
    "@effect/platform": "^0.97.2",
    "effect": "^3.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viell-dev/effect-schema-http.git"
  },
  "homepage": "https://github.com/viell-dev/effect-schema-http#readme",
  "bugs": {
    "url": "https://github.com/viell-dev/effect-schema-http/issues"
  }
}
