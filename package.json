{
  "name": "viell-effect-schema-http",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "Lazy, schema-driven HTTP request plans for Effect",
  "keywords": [
    "effect",
    "http",
    "schema",
    "typescript"
  ],
  "author": "viell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viell-dev/effect-schema-http.git"
  },
  "homepage": "https://github.com/viell-dev/effect-schema-http#readme",
  "bugs": {
    "url": "https://github.com/viell-dev/effect-schema-http/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && eslint .",
    "pack:check": "pnpm pack --dry-run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "test": "vitest run",
    "test:integration": "vitest run tests",
    "test:unit": "vitest run src",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/clean-build.mjs"
  },
  "peerDependencies": {
    "@effect/platform": "^0.97.2",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@effect/platform": "^0.97.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "effect": "^3.22.2",
    "eslint-plugin-oxlint": "^1.82.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
