{
  "name": "viell-effect-schema-http",
  "version": "0.1.0",
  "description": "Lazy, schema-driven HTTP request plans for Effect",
  "keywords": [],
  "author": "viell",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/request.integration.test.ts",
    "test:unit": "vitest run src/request.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@effect/platform": "^0.97.2",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@effect/platform": "^0.97.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "effect": "^3.22.2",
    "eslint-plugin-oxlint": "^1.82.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
